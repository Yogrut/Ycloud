# Base Compose publishes only on host loopback by default.
YCLOUD_PUBLISH_ADDRESS=127.0.0.1
YCLOUD_PORT=18473

# Direct LAN HTTP is the default application mode. To expose the published
# port to the LAN, change YCLOUD_PUBLISH_ADDRESS to 0.0.0.0 and keep these
# public HTTPS options commented out.

# Public HTTPS proxy mode: uncomment and replace all four values together.
# ALLOW_LAN_HTTP=false
# SECURE_COOKIES=true
# PUBLIC_BASE_URL=https://cloud.example.com
# TRUSTED_PROXY_IPS=172.18.0.1

# YCLOUD_CONFIG_KEY is optional. Do not save it in this file. Export it from a
# secret manager or deployment shell when an external master key is required.
