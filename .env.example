# Base Compose publishes only on host loopback by default.
YCLOUD_PUBLISH_ADDRESS=127.0.0.1
YCLOUD_PORT=18473

# Required only with compose.proxy.yaml.
PUBLIC_BASE_URL=https://cloud.example.com
TRUSTED_PROXY_IPS=172.18.0.1

# Do not save YCLOUD_CONFIG_KEY in this file. Export it from a secret manager
# or the deployment shell before starting compose.proxy.yaml.
