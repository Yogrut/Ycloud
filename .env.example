# Direct HTTP on port 18473 is the default and needs no .env file.

# Public HTTPS proxy mode: first uncomment the matching optional entries in
# compose.yaml, then uncomment and replace all four values here.
# ALLOW_LAN_HTTP=false
# SECURE_COOKIES=true
# PUBLIC_BASE_URL=https://cloud.example.com
# TRUSTED_PROXY_IPS=172.18.0.1

# External master keys are optional. Do not save YCLOUD_CONFIG_KEY here;
# export it from a secret manager or deployment shell when required.
